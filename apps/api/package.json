{
  "name": "@hoplab/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API Hoplab на Fastify (сервис, который заменит Python-сервис в service/)",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsdown",
    "start": "node dist/main.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "knip": "knip"
  },
  "dependencies": {
    "@fastify/cors": "11.4.0",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.2",
    "close-with-grace": "2.5.0",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hoplab/core": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "tsdown": "0.23.5",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
